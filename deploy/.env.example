# Yandex Object Storage (S3-compatible) credentials for presigned links.
# На проде: положите .env в ~/working_day_deploy/ — deploy_docker.sh подхватит при автодеплое.
#   cp .env.example .env   затем отредактируйте .env
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
